# ─── App ────────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3100
# 32+ random bytes, base64. `pnpm run setup` generates one. Signs the OAuth state cookie.
SESSION_SECRET=
# Demo mode: mock login (/login/dev), demo clock, simulated Shopify events. ALWAYS off when VERCEL_ENV=production.
DEMO_MODE=true

# ─── Collection ─────────────────────────────────────────────────────────────────
ADVENT_YEAR=2026
EDITION_SIZE=100
# Comma-separated emails that may open /admin (they still sign in through Shopify).
ADMIN_EMAILS=curator@example.com

# ─── Database (Supabase Postgres) ───────────────────────────────────────────────
# Local: the Docker Postgres from the CRM repo (port 5433), database "advent".
# Supabase: pooled "Transaction" string (port 6543) for runtime, direct (5432) for migrations.
DATABASE_URL=postgres://crm:crm@localhost:5433/advent
DATABASE_URL_UNPOOLED=postgres://crm:crm@localhost:5433/advent

# ─── Supabase Storage (empty = local disk in ./storage) ─────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=artworks

# ─── Shopify (all server-side; empty = dev adapters) ────────────────────────────
SHOPIFY_STORE_DOMAIN=
SHOPIFY_API_VERSION=2026-07
# Customer Account API (Headless / Hydrogen channel → Customer Account API → confidential client)
SHOPIFY_SHOP_ID=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=
# Admin API (custom app, scopes read_orders, read_customers)
SHOPIFY_ADMIN_ACCESS_TOKEN=
# The custom app's API secret key; used to verify webhook HMACs. Dev falls back to a local secret.
SHOPIFY_WEBHOOK_SECRET=
# Variant GIDs or numeric ids of the $4,999 collection product, comma-separated.
SHOPIFY_COLLECTION_VARIANT_IDS=demo-variant-1

# ─── Fulfillment ────────────────────────────────────────────────────────────────
# manual = CSV export for the print lab. Add a provider once the lab confirms an API.
FULFILLMENT_PROVIDER=manual
PRINT_LAB_NAME=Print lab (manual export)
PRINT_SKU_PREFIX=ADV
